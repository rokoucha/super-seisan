{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeType": "branch",
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "1 day",
  "packageRules": [
    {
      "description": "Keep hono-takibi's Effect dependencies on compatible versions",
      "matchPackageNames": ["@effect/platform-node-shared"],
      "enabled": false
    }
  ]
}
