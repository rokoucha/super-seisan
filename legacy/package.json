{
  "name": "super-seisan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host '::'",
    "fix": "prettier --write .",
    "generate": "mkdir -p src/generated/protobuf && pbjs ../superseisan.proto -t static-module -w es6 -o src/generated/protobuf/index.js && pbts src/generated/protobuf/index.js -o src/generated/protobuf/index.d.ts",
    "lint": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/serialize": "1.3.3",
    "@emotion/utils": "1.4.2",
    "@mantine/core": "6.0.22",
    "@mantine/hooks": "6.0.22",
    "protobufjs": "8.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "prettier": "3.8.2",
    "protobufjs-cli": "2.0.1",
    "typescript": "6.0.2",
    "vite": "8.0.8"
  }
}
