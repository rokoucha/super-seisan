{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "type": "module",
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "dependencies": {
    "@opennextjs/cloudflare": "1.14.10",
    "drizzle-orm": "0.45.1",
    "hono": "4.11.4",
    "next": "16.1.4",
    "prettier": "3.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.8",
    "typescript": "5.9.3",
    "wrangler": "4.59.2"
  },
  "scripts": {
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate": "pnpm run generate:cloudflare && pnpm run generate:next",
    "lint": "prettier --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "type-check": "tsc --noEmit"
  }
}
