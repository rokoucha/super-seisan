{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "dependencies": {
    "@hono/zod-openapi": "1.3.0",
    "@opennextjs/cloudflare": "1.19.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.14",
    "next": "16.2.4",
    "prettier": "3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "hono-takibi": "0.9.996",
    "npm-run-all2": "8.0.4",
    "typescript": "6.0.3",
    "vitest": "4.1.5",
    "wrangler": "4.84.1"
  },
  "scripts": {
    "build-cloudflare": "pnpm run generate && opennextjs-cloudflare build",
    "build": "next build",
    "deploy": " opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate:openapi": "pnpm hono-takibi ../api.yaml -o src/generated/routes.ts",
    "generate": "run-p generate:*",
    "lint": "prettier --check .",
    "preview": "pnpm run build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  }
}
