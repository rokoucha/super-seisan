{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@opennextjs/cloudflare": "1.20.6",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.9",
    "next": "16.3.6",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "hono-takibi": "0.15.0",
    "npm-run-all2": "9.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "wrangler": "4.140.0"
  },
  "scripts": {
    "build-cloudflare": "pnpm run generate && opennextjs-cloudflare build",
    "build": "next build",
    "deploy": " opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate:openapi": "pnpm hono-takibi ../api.yaml -o src/generated/routes.ts",
    "generate": "run-p generate:*",
    "lint": "prettier --check .",
    "preview": "pnpm run build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  }
}
