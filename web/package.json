{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "type": "module",
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "dependencies": {
    "@opennextjs/cloudflare": "1.14.8",
    "drizzle-orm": "0.45.1",
    "next": "16.1.2",
    "prettier": "3.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.8",
    "typescript": "5.9.3",
    "wrangler": "4.59.2"
  },
  "scripts": {
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate": "pnpm run generate:cloudflare && pnpm run generate:next",
    "lint": "prettier --check .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "type-check": "tsc --noEmit"
  }
}
