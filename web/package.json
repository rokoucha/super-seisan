{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1+sha512.48dae233635a645768a3028d19545cacc1688639eeb1f3734e42d6d6b971afbf22aa1ac9af52a173d9c3a20c15857cfa400f19994d79a2f626fcc73fccda9bbc",
  "dependencies": {
    "@hono/zod-openapi": "1.2.1",
    "@opennextjs/cloudflare": "1.16.3",
    "drizzle-orm": "0.45.1",
    "hono": "4.11.8",
    "next": "16.1.6",
    "prettier": "3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.2.2",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.8",
    "hono-takibi": "0.9.85",
    "npm-run-all2": "8.0.4",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "wrangler": "4.63.0"
  },
  "scripts": {
    "build-cloudflare": "pnpm run generate && opennextjs-cloudflare build",
    "build": "next build",
    "deploy": " opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate:openapi": "pnpm hono-takibi ../api.yaml -o src/generated/routes.ts",
    "generate": "run-p generate:*",
    "lint": "prettier --check .",
    "preview": "pnpm run build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  }
}
