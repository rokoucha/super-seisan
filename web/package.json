{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@opennextjs/cloudflare": "1.20.6",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "next": "16.3.4",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "hono-takibi": "0.9.99999",
    "npm-run-all2": "9.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "scripts": {
    "build-cloudflare": "pnpm run generate && opennextjs-cloudflare build",
    "build": "next build",
    "deploy": " opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate:openapi": "pnpm hono-takibi ../api.yaml -o src/generated/routes.ts",
    "generate": "run-p generate:*",
    "lint": "prettier --check .",
    "preview": "pnpm run build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  }
}
