{
  "name": "super-seisan-web",
  "description": "史上最強割り勘計算機",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@opennextjs/cloudflare": "1.20.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "next": "16.4.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "hono-takibi": "0.28.0",
    "npm-run-all2": "9.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "scripts": {
    "build-cloudflare": "pnpm run generate && opennextjs-cloudflare build",
    "build": "next build",
    "deploy": " opennextjs-cloudflare deploy",
    "dev": "next dev",
    "fix": "prettier --write .",
    "generate:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:next": "next typegen",
    "generate:openapi": "pnpm hono-takibi ../api.yaml -o src/generated/routes.ts",
    "generate": "run-p generate:*",
    "lint": "prettier --check .",
    "preview": "pnpm run build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  }
}
